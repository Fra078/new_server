# Copiare in /opt/homeserver/.env (chmod 600) e compilare. Mai committare il .env reale.
# Le variabili "stack" vengono passate a ogni stack Portainer da scripts/portainer-stacks.sh
# e usate da scripts/infra-up.sh per core/ e portainer/.

# --- Stack ---
TZ=Europe/Rome
PUID=1000
PGID=1000
APPDATA=/home/fra078/appdata          # config dei container (NVMe, incluso nel backup)
MEDIA_PATH=/mnt/mycloud/media_stack   # NAS: downloads/ + media/ (stesso fs -> hardlink)
OFFICE_PATH=/mnt/mycloud/office       # NAS: documenti per filebrowser/webdav
HOMEPAGE_ALLOWED_HOSTS=home.cetacean-fish.ts.net,127.0.0.1:3000
LIDARR_API_KEY=changeme

# --- Solo host (non passate agli stack) ---
PORTAINER_URL=http://127.0.0.1:9000
PORTAINER_TOKEN=changeme              # Portainer -> My account -> Access tokens
PORTAINER_ENDPOINT_ID=                # vuoto = rilevato automaticamente
REPO_URL=https://github.com/Fra078/new_server
REPO_REF=refs/heads/main
